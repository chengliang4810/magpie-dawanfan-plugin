{
  "name": "dawanfan",
  "version": "0.0.1",
  "description": "在 magpie 中使用大碗饭模型，网页登录即可连接，并查看套餐用量。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengliang4810/magpie-dawanfan-plugin.git"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "assets/logo.svg",
    "README.md",
    "docs/"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "auth",
    "provider",
    "magpie",
    "dawanfan",
    "大碗饭"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.mjs && node --check lib/dawan.mjs && node --check lib/login.mjs && node --check lib/browser-login.mjs && node scripts/check-package.mjs",
    "sync-icon": "node scripts/sync-icon.mjs",
    "prepack": "npm run check",
    "test:browser": "node scripts/smoke-browser.mjs"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "bundledDependencies": [
    "playwright-core"
  ]
}
